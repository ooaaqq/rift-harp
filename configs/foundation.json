    "bucket_probabilities": [0.2, 0.3, 0.5],
    "checkpoint_every_steps": 5000,
    "compile_mode": "max-autotune",
    "ema_decay": 0.9999,
    "eps": 1e-8,
    "frame_buckets": [256, 384, 512],
    "grad_clip_norm": 1.0,
